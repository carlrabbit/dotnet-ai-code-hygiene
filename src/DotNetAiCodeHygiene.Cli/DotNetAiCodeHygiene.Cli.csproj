<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DotNetAiCodeHygiene.Cli</AssemblyName>
    <RootNamespace>DotNetAiCodeHygiene.Cli</RootNamespace>
    <Version>0.1.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageId>DotNetAiCodeHygiene.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hygiene</ToolCommandName>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\packages</PackageOutputPath>
    <Description>Windows-first AI-assisted code hygiene command-line tool.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>
</Project>
