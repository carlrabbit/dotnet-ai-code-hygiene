{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "manifestSha256",
    "reviewer",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "m0015-boringness-assessment-submission"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "required": [
        "reviewerId",
        "role",
        "independenceConfirmed",
        "completedAtUtc"
      ],
      "properties": {
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "independenceConfirmed": {
          "type": "boolean"
        },
        "completedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "token",
          "q1",
          "q2",
          "q3",
          "q4",
          "q5",
          "outcome",
          "rationale",
          "evidence"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "q1": {
            "enum": [
              "yes",
              "no",
              "uncertain"
            ]
          },
          "q2": {
            "enum": [
              "yes",
              "no",
              "uncertain"
            ]
          },
          "q3": {
            "enum": [
              "yes",
              "no",
              "uncertain"
            ]
          },
          "q4": {
            "enum": [
              "yes",
              "no",
              "uncertain"
            ]
          },
          "q5": {
            "enum": [
              "yes",
              "no",
              "uncertain"
            ]
          },
          "outcome": {
            "enum": [
              "accepted",
              "negative",
              "uncertain"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "note"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
